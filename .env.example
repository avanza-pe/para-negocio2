# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca con prefijo NEXT_PUBLIC_. Se usa para guardar leads del formulario público.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (para enlaces de correo y metadatos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Agenda (Calendly / Google Calendar appointment schedule)
NEXT_PUBLIC_BOOKING_URL=
# WhatsApp comercial, solo números con código de país (ej. 51999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Correo público de contacto (se muestra en la web y en privacidad)
NEXT_PUBLIC_CONTACT_EMAIL=

# Correo transaccional con Brevo (https://app.brevo.com → SMTP & API → API Keys).
# El remitente debe estar verificado en Brevo (Senders & IP). Sin esto el lead igual se guarda.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=AVANZA
# Dónde llegan los avisos internos (nuevo lead, resumen diario)
NOTIFY_EMAIL_TO=

# IA para el flujo D (opcional). Sin esta clave, el panel ofrece "Copiar prompt".
ANTHROPIC_API_KEY=
# Máximo de generaciones por día (límite de gasto)
AI_DAILY_LIMIT=5

# Resumen diario (cron de Vercel). Genera un valor largo y aleatorio.
CRON_SECRET=
